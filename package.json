{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "nuxt build",
    "db-schema-push": "pnpm dlx instant-cli@latest push schema && pnpm dlx instant-cli@latest push perms",
    "dev": "nuxt dev --host 0.0.0.0 --port 3001",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "pnpm --filter semi-core test"
  },
  "dependencies": {
    "@instantdb/admin": "0.22.185",
    "@nuxt/icon": "1.13.0",
    "@nuxt/ui": "^3.3.7",
    "@pinia/nuxt": "^0.11.3",
    "@types/js-cookie": "^3.0.6",
    "@vueuse/shared": "^13.9.0",
    "@wagmi/core": "^2.22.1",
    "alchemy-sdk": "^3.6.5",
    "autoprefixer": "10.5.0",
    "bignumber.js": "^9.3.1",
    "dayjs": "1.11.20",
    "js-cookie": "^3.0.5",
    "nuxt": "4.5.2",
    "ox": "^0.8.0",
    "permissionless": "^0.2.57",
    "pinia": "^3.0.4",
    "qrcode.vue": "3.9.0",
    "semi-core": "workspace:*",
    "serialize-error": "^12.0.0",
    "solar-contract-sdk": "^0.0.3",
    "tailwindcss": "4.2.4",
    "trackjs": "^3.10.4",
    "viem": "2.48.4",
    "vue": "3.5.33",
    "vue-boring-avatars": "^1.4.0",
    "vue-qrcode-reader": "^5.7.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/ci": "^1.2.2",
    "prettier": "3.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
